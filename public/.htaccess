RewriteEngine On

# ─── Force HTTPS ────────────────────────────────────────────────
# Hostinger exposes HTTPS via X-Forwarded-Proto when behind their LB.
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1) Rutas de contenido servidas con su propio HTML.
#
#    Antes esto estaba detrás de un RewriteCond por User-Agent: solo los
#    bots de la lista recibían meta y texto reales, y cualquier otro
#    visitante — incluidos los agentes de IA que no estaban listados —
#    caía al index.html genérico, que dice ser el home en su canonical.
#    Ahora responde igual para todos; la SPA monta encima. Ver
#    api/seo-shell.php.
RewriteRule ^blog/(.+)$ /api/blog-prerender.php?slug=$1 [L,QSA]
RewriteRule ^work/(.+)$ /api/work-prerender.php?slug=$1 [L,QSA]
RewriteRule ^lost-and-found-shop/([^/]+)/?$ /api/shop-prerender.php?slug=$1 [L,QSA]

# 2b) Rutas base. Sin esto las seis sirven el index.html del build, que
#     trae el canonical del home: Google las lee como duplicados.
#     Van DESPUÉS de las de arriba para no robarles /work/{slug}.
RewriteRule ^$ /api/page-prerender.php?route= [L,QSA]
RewriteRule ^(about|work|blog|contact|lost-and-found-shop)/?$ /api/page-prerender.php?route=$1 [L,QSA]

# 1c) El sitemap se arma desde la base: un proyecto o un post nuevo entra
#     solo, sin que nadie edite un XML a mano.
RewriteRule ^sitemap\.xml$ /api/sitemap.php [L]

# 2) Serve existing files/directories (assets, media, etc.)
#    Va después de las rutas de contenido: "/" resuelve al directorio y
#    esta regla se lo quedaría antes de que page-prerender lo viera.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) SPA fallback within this directory (e.g., /development)
# Use relative path so it works regardless of subfolder name
RewriteRule . index.html [L]


# ─── Security headers ────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — lock the browser to HTTPS for a year (include subdomains so api.mroscar.xyz etc. are covered)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Prevent clickjacking. SAMEORIGIN allows our own frames (e.g. admin panel if needed).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Block MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Don't leak full URLs to third-parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable powerful APIs we don't need
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    # Cross-Origin resource policies (safe defaults for a portfolio site)
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Strip server version disclosure
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # CSP in Report-Only mode first — three.js + GA4 + TipTap need inline/unsafe-eval in places.
    # Flip to enforcing (Content-Security-Policy) once you've monitored reports for a week.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://auth.privy.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.google-analytics.com https://*.privy.io https://auth.privy.io https://ip-api.com https://translate.googleapis.com wss: https:; worker-src 'self' blob:; frame-src 'self' https://auth.privy.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"
</IfModule>

# ─── Caché del HTML ──────────────────────────────────────────────
# index.html se revalida en cada visita (ETag → 304 si no cambió): sin esto
# el navegador lo cacheaba a su criterio y después de un deploy seguía
# cargando el bundle anterior. Los JS/CSS de /assets llevan hash en el
# nombre, así que ellos no necesitan esta regla.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ─── Hide dotfiles and common leak targets ───────────────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|bak|backup|old|orig|save|log|sql|sqlite|db|ini|tmpl|dist|example|swp|swo|swn)$">
    Require all denied
</FilesMatch>

# Block access to VCS metadata if ever uploaded
RedirectMatch 404 /\.(git|hg|svn)(/.*)?$
RedirectMatch 404 /(node_modules|vendor|directives|execution|scripts)(/.*)?$

# Disable directory listing site-wide
Options -Indexes
