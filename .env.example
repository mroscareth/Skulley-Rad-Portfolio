# ──────────────────────────────────────────────
# Skulley Rad Portfolio — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Privy (auth)
# VITE_PRIVY_APP_ID=

# Google OAuth (for Sheets/Slides integration)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Translation API
# TRANSLATE_API_KEY=

# CMS / Database
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=

# ──────────────────────────────────────────────
# Stripe — SOLO para el entorno local (docker-compose → config.dev.php)
# ──────────────────────────────────────────────
# Usa llaves de PRUEBA. En producción las llaves viven en
# public/api/config.local.php (no aquí): el frontend nunca ve ninguna.
# Dashboard (modo prueba) → Developers → API keys → Secret key
# STRIPE_SECRET_KEY=sk_test_...
# Lo imprime `stripe listen --forward-to localhost:8080/api/shop-webhook.php`
# STRIPE_WEBHOOK_SECRET=whsec_...
