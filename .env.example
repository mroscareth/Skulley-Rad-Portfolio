# ──────────────────────────────────────────────
# Skulley Rad Portfolio — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Privy (auth)
# VITE_PRIVY_APP_ID=

# Google OAuth (for Sheets/Slides integration)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Translation API
# TRANSLATE_API_KEY=

# CMS / Database
# DB_HOST=
# DB_USER=
# DB_PASS=
# DB_NAME=

# ──────────────────────────────────────────────
# Shopify — Storefront API (frontend, public)
# ──────────────────────────────────────────────
# Shop domain, e.g. your-shop.myshopify.com (no https://)
# VITE_SHOPIFY_DOMAIN=
# Storefront access token (public, safe to expose)
# Shopify admin → Apps → Develop apps → your app → API credentials → Storefront API access token
# VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional — API version (default: 2025-01)
# VITE_SHOPIFY_API_VERSION=2025-01
# Optional — collection handle to render in the shop (default: lost-and-found-items)
# VITE_SHOPIFY_COLLECTION_HANDLE=lost-and-found-items

# ──────────────────────────────────────────────
# Shopify — Admin API (server-side PHP, SECRET)
# ──────────────────────────────────────────────
# NEVER expose to the frontend. Used only from public/api/ on Hostinger.
# Admin → Apps → Develop apps → your app → API credentials → Admin API access token
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ADMIN_TOKEN=
